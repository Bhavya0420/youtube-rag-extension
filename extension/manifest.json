{
    "manifest_version": 3,
    "name": "YouTube RAG Assistant",
    "version": "1.0",
    "description": "Ask questions about the current YouTube video using RAG.",
    
    "permissions": [
        "tabs"
    ],

    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],

    "action": {
        "default_popup": "popup.html"
    }
}